{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "dist",
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**", "src/__fixtures__/**"]
}
